<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>dkd-parent</artifactId>
        <groupId>com.dkd</groupId>
        <version>3.8.7</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>dkd-manage</artifactId>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- 核心模块-->
        <dependency>
            <groupId>com.dkd</groupId>
            <artifactId>dkd-framework</artifactId>
        </dependency>

        <!-- WebSocket 长连接模块（行为实时监控推送） -->
        <dependency>
            <groupId>com.dkd</groupId>
            <artifactId>dkd-websocket</artifactId>
        </dependency>

        <!-- ClickHouse JDBC（用于用户行为轨迹查询） -->
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
            <version>0.6.0</version>
        </dependency>

        <!-- ClickHouse JDBC HTTP 传输依赖（Apache HttpClient 5） -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>5.3.1</version>
        </dependency>

        <!-- Caffeine Cache -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>2.9.3</version> <!-- Clean version compatible with Java 8/11 -->
        </dependency>
    </dependencies>

</project>
