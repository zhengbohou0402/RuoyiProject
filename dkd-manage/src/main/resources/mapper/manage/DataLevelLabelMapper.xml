<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dkd.manage.mapper.DataLevelLabelMapper">

    <resultMap type="DataLevelLabel" id="DataLevelLabelResult">
        <result property="id" column="id"/>
        <result property="channelId" column="channel_id"/>
        <result property="eventCode" column="event_code"/>
        <result property="dataLevel" column="data_level"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectDataLevelLabelVo">
        select id, channel_id, event_code, data_level, create_by, create_time, update_by, update_time
        from tb_data_level_label
    </sql>

    <select id="selectDataLevelLabelList" parameterType="DataLevelLabel" resultMap="DataLevelLabelResult">
        <include refid="selectDataLevelLabelVo"/>
        <where>
            <if test="channelId != null and channelId != ''">and channel_id = #{channelId}</if>
            <if test="eventCode != null and eventCode != ''">and event_code = #{eventCode}</if>
            <if test="dataLevel != null and dataLevel != ''">and data_level = #{dataLevel}</if>
            <if test="searchValue != null and searchValue != ''">
                AND (channel_id LIKE concat('%', #{searchValue}, '%') OR event_code LIKE concat('%', #{searchValue}, '%'))
            </if>
        </where>
    </select>

    <select id="selectDataLevelLabelById" parameterType="Long" resultMap="DataLevelLabelResult">
        <include refid="selectDataLevelLabelVo"/>
        where id = #{id}
    </select>

    <insert id="insertDataLevelLabel" parameterType="DataLevelLabel" useGeneratedKeys="true" keyProperty="id">
        insert into tb_data_level_label
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="channelId != null and channelId != ''">channel_id,</if>
            <if test="eventCode != null and eventCode != ''">event_code,</if>
            <if test="dataLevel != null and dataLevel != ''">data_level,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="channelId != null and channelId != ''">#{channelId},</if>
            <if test="eventCode != null and eventCode != ''">#{eventCode},</if>
            <if test="dataLevel != null and dataLevel != ''">#{dataLevel},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
            ON DUPLICATE KEY UPDATE
            data_level = VALUES(data_level),
            update_by = VALUES(create_by),
            update_time = sysdate()
    </insert>

    <insert id="batchInsertDataLevelLabel">
        INSERT INTO tb_data_level_label (
        channel_id,
        event_code,      data_level,
        create_by,
        create_time
        )
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.channelId},   #{item.eventCode},   #{item.dataLevel},
            #{item.createBy},
            #{item.createTime}
            )
        </foreach>

        ON DUPLICATE KEY UPDATE
        data_level = VALUES(data_level),
        update_by = VALUES(create_by),     -- 借用本次插入的 create_by 更新
        update_time = VALUES(create_time)  -- 借用本次插入的 create_time 更新
    </insert>

    <update id="updateDataLevelLabel" parameterType="DataLevelLabel">
        update tb_data_level_label
        <trim prefix="SET" suffixOverrides=",">
            <if test="channelId != null and channelId != ''">channel_id = #{channelId},</if>
            <if test="eventCode != null and eventCode != ''">event_code = #{eventCode},</if>
            <if test="dataLevel != null and dataLevel != ''">data_level = #{dataLevel},</if>
            <if test="createBy != null and createBy != ''">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <!-- 批量查重：按(channel_id,event_code)在给定集合内查询已存在记录 -->
    <select id="selectExistingList" resultMap="DataLevelLabelResult">
        <include refid="selectDataLevelLabelVo"/>
        <where>
            <if test="channelIds != null and channelIds.size() > 0">
                AND channel_id IN
                <foreach collection="channelIds" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="eventCodes != null and eventCodes.size() > 0">
                AND event_code IN
                <foreach collection="eventCodes" item="code" open="(" separator="," close=")">
                    #{code}
                </foreach>
            </if>
        </where>
    </select>


    <select id="selectAllEventCodes" resultType="java.lang.String">
        SELECT DISTINCT event_code FROM tb_metadata_event
    </select>

    <select id="selectAllChannelIds" resultType="java.lang.String">
        SELECT DISTINCT channel_id FROM tb_coding_scheme_channel_manage
    </select>

    <delete id="deleteDataLevelLabelById" parameterType="Long">
        delete from tb_data_level_label where id = #{id}
    </delete>



</mapper>