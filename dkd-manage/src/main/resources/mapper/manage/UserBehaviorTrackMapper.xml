<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dkd.manage.mapper.UserBehaviorTrackMapper">

    <!--
      轨迹表：默认使用 tb_user_behavior_track
      字段示例（按需求文档）：client_time, userId, WT_et, WT_ti, WT_es, WT_envName, WT_event
      如你们实际表名/字段不同，只需改 select/where 的字段名即可
    -->
    <resultMap id="UserBehaviorTrackResult" type="com.dkd.manage.domain.vo.TbUserBehaviorTrackVo">
        <result property="clientTime" column="client_time"/>
        <result property="userId" column="userId"/>
        <result property="wtEt" column="WT_et"/>
        <result property="wtTi" column="WT_ti"/>
        <result property="wtEs" column="WT_es"/>
        <result property="wtEnvName" column="WT_envName"/>
        <result property="wtEvent" column="WT_event"/>
    </resultMap>

    <sql id="selectUserBehaviorTrackVo">
        SELECT
            -- 时间
            `daytime` AS client_time,
            -- 手机号（接口字段 userId）
            `wt_mobile` AS userId,
            -- 事件类型
            `wt_et` AS WT_et,
            -- 页面名称
            `wt_ti` AS WT_ti,
            -- 页面链接
            `wt_es` AS WT_es,
            -- 点位内容
            `wt_envname` AS WT_envName,
            -- 事件编码
            `wt_event` AS WT_event
        FROM tb_easydata_user_trackinfo_complete_local
    </sql>

<sql id="whereCondition">
    <trim prefix="PREWHERE" prefixOverrides="AND |OR ">
        
        <if test="phone != null and phone != ''">
            AND wt_mobile = #{phone}
        </if>

        <if test="beginTime != null">
            AND daytime &gt;= #{beginTime}
        </if>
        <if test="endTime != null">
            AND daytime &lt;= #{endTime}
        </if>

        AND wt_et != 'imp'
        
    </trim>
</sql>

    <!--
      分页查询
      注意：这里的 ORDER BY daytime DESC 是手写死的，ClickHouse 的 MergeTree 引擎不加
      ORDER BY 时不保证返回顺序（按存储的 primary key 顺序返回，不是插入顺序/查询顺序）。
      面试踩坑点：正因为这里已经手写了 ORDER BY，这条查询绝对不能再走 RuoYi 通用的
      startPage()（PageUtils#startPage），否则 PageHelper.startPage(pageNum,pageSize,orderBy)
      会在末尾再拼一次 order by，变成双 ORDER BY 语法错误。所以本查询走的是
      UserBehaviorTrackServiceImpl 里的全量查询 + Redis/Caffeine 缓存 + 内存分页方案，
      彻底不让 PageHelper 介入这条 SQL。
    -->
    <select id="selectUserBehaviorTrackList"
            parameterType="com.dkd.manage.domain.dto.UserBehaviorTrackQueryDTO"
            resultMap="UserBehaviorTrackResult">
        <include refid="selectUserBehaviorTrackVo"/>
        <include refid="whereCondition"/>
        ORDER BY daytime DESC
    </select>

    <!-- 查询总数 -->
    <select id="countUserBehaviorTrack"
            parameterType="com.dkd.manage.domain.dto.UserBehaviorTrackQueryDTO"
            resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM tb_easydata_user_trackinfo_complete_local
        <include refid="whereCondition"/>
    </select>

    <!--
      【模拟长连接-数据生成器用】插入一条轨迹数据
      注意：useGeneratedKeys="false" 是必须的——全局 mybatis-config.xml 里
      useGeneratedKeys 默认是 true，但 ClickHouse JDBC 驱动不支持返回自增主键
      （ClickHouse 本身也没有自增主键的概念），不关掉会抛
      java.sql.SQLFeatureNotSupportedException: Only NO_GENERATED_KEYS is supported
    -->
    <insert id="insertTrackData" useGeneratedKeys="false">
        INSERT INTO tb_easydata_user_trackinfo_complete_local
        (daytime, wt_mobile, wt_et, wt_ti, wt_es, wt_envname, wt_event, statis_date)
        VALUES
        (#{daytime}, #{mobile}, #{wtEt}, #{wtTi}, #{wtEs}, #{wtEnvName}, #{wtEvent}, #{statisDate})
    </insert>

    <!-- 【模拟长连接-增量轮询用】查询 afterTime 之后新增的轨迹数据 -->
    <select id="selectIncrementalTrack" resultMap="UserBehaviorTrackResult">
        <include refid="selectUserBehaviorTrackVo"/>
        <trim prefix="PREWHERE" prefixOverrides="AND |OR ">
            AND wt_mobile = #{phone}
            <if test="afterTime != null">
                AND daytime &gt; #{afterTime}
            </if>
            AND wt_et != 'imp'
        </trim>
        ORDER BY daytime ASC
        LIMIT 200
    </select>

    <!-- 【模拟长连接-增量轮询用】查询增量数据里最大的 daytime，作为下次轮询基准 -->
    <select id="selectMaxDaytime" resultType="java.util.Date">
        SELECT MAX(daytime)
        FROM tb_easydata_user_trackinfo_complete_local
        <trim prefix="PREWHERE" prefixOverrides="AND |OR ">
            AND wt_mobile = #{phone}
            <if test="afterTime != null">
                AND daytime &gt; #{afterTime}
            </if>
        </trim>
    </select>

</mapper>