<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.icm.manage.mapper.TbCodingSchemeFieldMaintenanceMapper">

    <!-- FieldConfigVO 结果映射 -->
    <resultMap id="FieldConfigVOResult" type="com.icm.manage.domain.vo.FieldConfigVO">
        <!-- 字段元数据信息 -->
        <result property="fieldIdentification"    column="field_identification"    />
        <result property="fieldName"              column="field_name"              />
        <result property="fieldType"              column="field_type"              />
        <result property="maintenanceTime"        column="maintenance_time"        />

        <!-- 规则配置信息（可能为空） -->
        <result property="configId"               column="config_id"               />
        <result property="datasourceId"           column="datasource_id"           />
        <result property="tableName"              column="table_name"              />
        <result property="sampleCount"            column="sample_count"            />
        <result property="isNotNull"              column="is_not_null"              />
        <result property="formatValidationType"   column="format_validation_type"   />
        <result property="dateFormat"             column="date_format"             />
        <result property="urlProtocol"            column="url_protocol"            />
        <result property="isContentNumber"        column="is_content_number"        />
        <result property="isContentChinese"       column="is_content_chinese"       />
        <result property="isContentLowercase"     column="is_content_lowercase"     />
        <result property="isContentUppercase"     column="is_content_uppercase"     />
        <result property="customRegex"            column="custom_regex"            />
        <result property="lengthMin"              column="length_min"              />
        <result property="lengthMax"              column="length_max"              />
        <result property="enumValues"             column="enum_values"             />
        <result property="isEnabled"              column="is_enabled"              />
        <result property="remark"                 column="remark"                  />
    </resultMap>

    <!-- 查询字段列表（含所有规则配置） -->
    <select id="selectFieldListWithConfig" resultMap="FieldConfigVOResult">
        SELECT
            fm.field_identification,
            fm.field_name,
            fm.field_type,
            fm.maintenance_time,
            fc.id as config_id,
            fc.datasource_id,
            fc.table_name,
            fc.sample_count,
            fc.is_not_null,
            fc.format_validation_type,
            fc.date_format,
            fc.url_protocol,
            fc.is_content_number,
            fc.is_content_chinese,
            fc.is_content_lowercase,
            fc.is_content_uppercase,
            fc.custom_regex,
            fc.length_min,
            fc.length_max,
            fc.enum_values,
            fc.is_enabled,
            fc.remark
        FROM tb_coding_scheme_field_maintenance fm
        LEFT JOIN tb_field_validation_config fc
        ON fm.field_identification = fc.field_identification
        <where>
            <if test="datasourceId != null and datasourceId != ''">
                AND (fc.datasource_id = #{datasourceId} OR fc.datasource_id IS NULL)
            </if>
        </where>
        ORDER BY fm.id, fc.datasource_id
    </select>

</mapper>